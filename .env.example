# 复制本文件为 .env 并填入配置

# ============================================================
# 数据库（PostgreSQL）
# 首次部署：先用超级用户执行 setup_postgres.sql 创建账号和数据库
# ============================================================
# 本机部署无需填写 host/port（代码默认 localhost:5432）；远程部署才取消注释修改
# DB_HOST=localhost
# DB_PORT=5432
DB_NAME=kanban_demo
DB_USER=demoapp
DB_PASSWORD=

# 若启动后报「无法按 UTF-8 解析」，通常是 PostgreSQL 的 lc_messages 设成了中文编码：
# 把 postgresql.conf 里的 lc_messages 改成 'C' 并重启 PostgreSQL 服务即可。

# ============================================================
# LLM API Key
# 任选其一即可，推荐 DeepSeek（便宜、中文表现好）
# ============================================================

# DeepSeek（推荐）- 申请：https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 通义千问（阿里云百炼）- 申请：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=

# 智谱 GLM - 申请：https://open.bigmodel.cn
ZHIPU_API_KEY=

# OpenAI（可选）
OPENAI_API_KEY=

# ============================================================
# 钉钉群机器人提醒（可选）
# 创建：钉钉群 → 群设置 → 机器人 → 添加机器人 → 自定义（安全设置选「加签」）
# Webhook 形如 https://oapi.dingtalk.com/robot/send?access_token=xxx
# SECRET 为「加签」密钥（SEC 开头）；若机器人安全设置未选加签则留空
# 用户的「手机号」在系统「用户管理」页填写，用于 @ 提醒到人
#
# 默认群（下面两行）：标题不含业务标签、或标签对应群未配置时，消息发到这里
# ============================================================
DINGTALK_WEBHOOK=
DINGTALK_SECRET=

# 业务群（可选，按需增删）：DINGTALK_WEBHOOK_<标签> + 可选 DINGTALK_SECRET_<标签>
# 需求标题含对应标签（不分大小写）时，群消息发到对应业务群而非默认群；
# 新增业务群只需加两行配置，不用改代码。示例（ZX / RX / QX 三个业务群）：
# DINGTALK_WEBHOOK_A=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET_A=SECxxxxxxxx
# DINGTALK_WEBHOOK_B=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET_B=SECxxxxxxxx
# DINGTALK_WEBHOOK_C=https://oapi.dingtalk.com/robot/send?access_token=xxx
# DINGTALK_SECRET_C=SECxxxxxxxx

# 企业内部应用（可选，用于「用户管理」按姓名自动匹配钉钉用户，免填手机号/邮箱）
# 创建：open.dingtalk.com → 应用开发 → 企业内部应用；权限开「通讯录部门信息读」+「通讯录个人信息读」
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=

# ============================================================
# 邮件提醒（可选，未配置则只走钉钉）
# 钉邮/阿里企业邮箱：smtp.qiye.aliyun.com · 465
# QQ 邮箱：smtp.qq.com · 465（密码填「授权码」，邮箱设置→账户→开启 SMTP 后生成）
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

